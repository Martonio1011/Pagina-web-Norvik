<div style="max-width:800px;margin:0 auto;padding:64px 40px 100px;display:flex;flex-direction:column;gap:32px;">
  <div style="display:flex;justify-content:space-between;align-items:center;">
    <h1 style="font-family:var(--font-heading);font-size:26px;color:var(--color-text);margin:0;">hola, {{ customer.first_name | downcase }}</h1>
    <a class="button-link" href="{{ routes.account_logout_url }}">cerrar sesión</a>
  </div>

  <div>
    <h2 style="font-family:var(--font-body);font-size:11.5px;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:16px;">pedidos</h2>
    {% if customer.orders.size == 0 %}
      <p style="font-family:var(--font-body);font-size:14px;color:var(--color-text-secondary);">aún no tienes pedidos.</p>
    {% else %}
      <div style="display:flex;flex-direction:column;">
        {% for order in customer.orders %}
          <a href="{{ order.customer_url }}" style="display:flex;justify-content:space-between;padding:16px 0;border-bottom:1px solid rgba(43,38,33,0.08);text-decoration:none;color:var(--color-text);font-family:var(--font-body);font-size:13.5px;">
            <span>{{ order.name }}</span>
            <span>{{ order.created_at | date: '%d/%m/%Y' }}</span>
            <span>{{ order.total_price | money }}</span>
            <span>{{ order.fulfillment_status_label }}</span>
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>
