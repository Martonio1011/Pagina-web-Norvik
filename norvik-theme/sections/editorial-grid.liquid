{{ 'norvik.css' | asset_url | stylesheet_tag }}

<section class="nv-section" style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px">
  <div class="nv-wrap">
    <div class="nv-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="nv-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="nv-h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    </div>

    <div class="nv-editorial">
      {%- for block in section.blocks -%}
        {%- liquid
          assign target = block.settings.collection
          assign link = block.settings.link
          if link == blank and target != blank
            assign link = target.url
          endif
          assign image = block.settings.image
          if image == blank and target != blank
            assign image = target.featured_image
          endif
        -%}
        <a href="{{ link | default: '#' }}" class="nv-editorial__item" {{ block.shopify_attributes }}>
          {%- if image != blank -%}
            {{
              image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '300,500,700,900,1200',
                sizes: '(min-width: 990px) 50vw, 50vw',
                alt: image.alt | default: block.settings.title
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          {%- endif -%}
          <span class="nv-editorial__scrim"></span>
          <span class="nv-editorial__label">
            <strong>{{ block.settings.title | escape }}</strong>
            {%- if block.settings.cta != blank -%}
              <span>{{ block.settings.cta | escape }}</span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial grid",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Where are you going?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the occasion" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Vacation" },
        { "type": "text", "id": "cta", "label": "Link text", "default": "Shop now" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Custom link", "info": "Overrides the collection link." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Falls back to the collection image." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial grid",
      "blocks": [
        { "type": "look", "settings": { "title": "Vacation" } },
        { "type": "look", "settings": { "title": "Wedding guest" } },
        { "type": "look", "settings": { "title": "Weekend" } },
        { "type": "look", "settings": { "title": "Date night" } }
      ]
    }
  ]
}
{% endschema %}
