{{ 'norvik.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Uses Shopify's native recommendation engine. On first paint the section is
  empty; norvik.js fetches the rendered section from
  /recommendations/products and swaps it in, which is the pattern Shopify
  requires for recommendations to be personalised and cached correctly.
{%- endcomment -%}

<div
  class="nv-section"
  data-nv-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}"
  style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="nv-wrap">
      <div class="nv-head">
        <h2 class="nv-h2">{{ section.settings.heading | escape }}</h2>
      </div>
      <div class="nv-grid" data-cols="4">
        {%- for product in recommendations.products -%}
          {% render 'norvik-card', product: product %}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Complete the look",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the look" },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "default": "complementary",
      "options": [
        { "value": "complementary", "label": "Goes well with (complementary)" },
        { "value": "related", "label": "Similar products (related)" }
      ],
      "info": "Complementary needs the Search & Discovery app to define pairings; it falls back to related automatically."
    },
    { "type": "range", "id": "products_to_show", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ]
}
{% endschema %}
