{{ 'norvik.css' | asset_url | stylesheet_tag }}

{%- assign rail_id = 'nv-ugc-' | append: section.id -%}

<section class="nv-section" style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px">
  <div class="nv-wrap">
    <div class="nv-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="nv-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="nv-h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      <div class="nv-rail-nav" data-nv-rail-nav="{{ rail_id }}">
        <button type="button" data-nv-rail-prev aria-label="{{ 'norvik.rail.previous' | t }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button type="button" data-nv-rail-next aria-label="{{ 'norvik.rail.next' | t }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <div class="nv-rail" id="{{ rail_id }}">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign tag = 'div'
            if block.settings.link != blank
              assign tag = 'a'
            endif
          -%}
          <{{ tag }}
            class="nv-ugc__item"
            {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 700
                | image_tag: loading: 'lazy', widths: '200,300,400,500,700', sizes: '(min-width: 990px) 23vw, 60vw', alt: block.settings.handle
              }}
              {%- if block.settings.handle != blank -%}
                <span class="nv-ugc__handle">{{ block.settings.handle | escape }}</span>
              {%- endif -%}
            {%- else -%}
              <span class="nv-ugc__empty">
                {{ 'norvik.ugc.placeholder' | t }}
              </span>
            {%- endif -%}
          </{{ tag }}>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%}
          No photos yet. Real customer photography only arrives after the first
          orders, so the section stays visible with honest placeholders rather
          than faking social proof.
        {%- endcomment -%}
        {%- for i in (1..4) -%}
          <div class="nv-ugc__item">
            <span class="nv-ugc__empty">{{ 'norvik.ugc.placeholder' | t }}</span>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "UGC carousel",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "@norvik" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "As worn by you" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Customer photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "handle", "label": "Credit", "default": "@customer" },
        { "type": "url", "id": "link", "label": "Link to product" }
      ]
    }
  ],
  "presets": [{ "name": "UGC carousel" }]
}
{% endschema %}
