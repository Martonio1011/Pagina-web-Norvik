{{ 'norvik.css' | asset_url | stylesheet_tag }}

<section
  class="nv-hero{% if section.settings.alignment == 'center' %} nv-hero--center{% endif %}"
  data-height="{{ section.settings.height }}"
>
  <div class="nv-hero__media">
    {%- if section.settings.image -%}
      {{
        section.settings.image
        | image_url: width: 3000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '600,900,1200,1600,2000,2600,3000',
          sizes: '100vw',
          alt: section.settings.image.alt | default: section.settings.heading
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  {%- if section.settings.overlay > 0 -%}
    <div class="nv-hero__scrim" style="opacity: {{ section.settings.overlay | divided_by: 100.0 }}"></div>
  {%- endif -%}

  <div class="nv-hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="nv-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="nv-display">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="nv-hero__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <div class="nv-hero__ctas">
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: '#' }}" class="nv-btn nv-btn--light">
          {{ section.settings.cta_label | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.cta2_label != blank -%}
        <a
          href="{{ section.settings.cta2_link | default: '#' }}"
          class="nv-btn"
          style="background:transparent;border-color:#fff;color:#fff"
        >
          {{ section.settings.cta2_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero campaign",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "large",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Bottom left" },
        { "value": "center", "label": "Centre" }
      ]
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Image darkening",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 40,
      "info": "Keeps the headline readable over busy photography."
    },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New season" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Dresses made for warm nights" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting line",
      "default": "Maxi, mini and everything for the summer ahead."
    },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "Shop dresses" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "Hero campaign" }]
}
{% endschema %}
