{{ 'norvik.css' | asset_url | stylesheet_tag }}

<section class="nv-section" style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px">
  <div class="nv-wrap">
    <div class="nv-incentives" data-count="{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign body = block.settings.text
          comment
            {{ threshold }} is replaced with the shop-wide free shipping value
            so the number only ever lives in one setting.
          endcomment
          assign threshold_value = settings.nv_free_shipping_threshold | default: 75
          assign threshold = threshold_value | times: 100 | money_without_trailing_zeros
          assign body = body | replace: '{{ threshold }}', threshold
        -%}
        <div class="nv-incentive" {{ block.shopify_attributes }}>
          <strong>{{ block.settings.title | escape }}</strong>
          <p>{{ body }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Incentive bar",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "paragraph",
      "content": "Use {{ threshold }} inside any text to print the free shipping amount set in Theme settings → Norvik."
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Incentive",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "On every order over {{ threshold }}." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Incentive bar",
      "blocks": [
        { "type": "item", "settings": { "title": "Free shipping", "text": "On every order over {{ threshold }}." } },
        { "type": "item", "settings": { "title": "15% off your first order", "text": "Join the list and we'll send your code." } },
        { "type": "item", "settings": { "title": "Easy returns", "text": "30 days to change your mind." } }
      ]
    }
  ]
}
{% endschema %}
