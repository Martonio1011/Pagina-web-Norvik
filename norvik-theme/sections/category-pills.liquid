{{ 'norvik.css' | asset_url | stylesheet_tag }}

<section class="nv-section" style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px">
  <div class="nv-wrap">
    {%- if section.settings.heading != blank -%}
      <div class="nv-head">
        <h2 class="nv-h2">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <nav class="nv-pills{% if section.settings.style == 'visual' %} nv-pills--visual{% endif %}" aria-label="{{ section.settings.heading | default: 'Categories' | escape }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign target = block.settings.collection
          assign label = block.settings.label
          if label == blank and target != blank
            assign label = target.title
          endif
          assign link = block.settings.link
          if link == blank and target != blank
            assign link = target.url
          endif

          assign thumb = block.settings.image
          if thumb == blank and target != blank
            assign thumb = target.featured_image
          endif
        -%}
        {%- if label != blank -%}
          <a href="{{ link | default: '#' }}" class="nv-pill" {{ block.shopify_attributes }}>
            {%- if thumb != blank -%}
              {{
                thumb
                | image_url: width: 240
                | image_tag: loading: 'lazy', widths: '80,120,160,240', class: 'nv-pill__thumb', alt: ''
              }}
            {%- endif -%}
            <span>{{ label | escape }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  </div>
</section>

{% schema %}
{
  "name": "Category pills",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "text",
      "options": [
        { "value": "text", "label": "Text pills" },
        { "value": "visual", "label": "Circular images" }
      ]
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 8 }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label", "info": "Leave empty to use the collection name." },
        { "type": "url", "id": "link", "label": "Custom link", "info": "Overrides the collection link. Use for tag filters such as /collections/dresses/maxi-dress." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Only used by the circular style. Falls back to the collection image." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category pills",
      "blocks": [{ "type": "pill" }, { "type": "pill" }, { "type": "pill" }, { "type": "pill" }]
    }
  ]
}
{% endschema %}
