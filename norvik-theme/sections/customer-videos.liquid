{{ 'norvik.css' | asset_url | stylesheet_tag }}

{%- assign rail_id = 'nv-vid-' | append: section.id -%}

<section class="nv-section" style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px">
  <div class="nv-wrap">
    <div class="nv-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="nv-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="nv-h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p style="margin:.5rem 0 0;font-size:.9375rem;color:var(--nv-ink-soft)">
            {{ section.settings.subheading | escape }}
          </p>
        {%- endif -%}
      </div>
      <div class="nv-rail-nav" data-nv-rail-nav="{{ rail_id }}">
        <button type="button" data-nv-rail-prev aria-label="{{ 'norvik.rail.previous' | t }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button type="button" data-nv-rail-next aria-label="{{ 'norvik.rail.next' | t }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <div class="nv-rail" id="{{ rail_id }}">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign has_native = false
            if block.settings.video != blank
              assign has_native = true
            endif

            assign embed_url = ''
            if block.settings.video_url != blank
              if block.settings.video_url.type == 'youtube'
                assign embed_url = 'https://www.youtube.com/embed/' | append: block.settings.video_url.id | append: '?autoplay=1&rel=0&playsinline=1'
              elsif block.settings.video_url.type == 'vimeo'
                assign embed_url = 'https://player.vimeo.com/video/' | append: block.settings.video_url.id | append: '?autoplay=1'
              endif
            endif

            assign label = block.settings.name | default: 'Customer video'
          -%}

          <div class="nv-video" data-nv-video {{ block.shopify_attributes }}>
            {%- if has_native -%}
              {%- comment -%}
                preload="none" keeps the file off the initial page load; the
                poster is Shopify's own video preview image.
              {%- endcomment -%}
              {{
                block.settings.video
                | video_tag: image_size: '600x', preload: 'none', playsinline: true, muted: false
              }}
              <button type="button" class="nv-video__facade" data-nv-video-play aria-label="{{ 'norvik.video.play' | t }}: {{ label | escape }}">
                <span class="nv-video__play">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                </span>
              </button>

            {%- elsif embed_url != blank -%}
              {%- if block.settings.poster != blank -%}
                {{
                  block.settings.poster
                  | image_url: width: 700
                  | image_tag: loading: 'lazy', widths: '200,300,400,500,700', sizes: '(min-width: 990px) 23vw, 60vw', alt: label
                }}
              {%- endif -%}
              <button type="button" class="nv-video__facade" data-nv-video-play="{{ embed_url }}" aria-label="{{ 'norvik.video.play' | t }}: {{ label | escape }}">
                <span class="nv-video__play">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                </span>
              </button>

            {%- else -%}
              <span class="nv-video__empty">{{ 'norvik.video.placeholder' | t }}</span>
            {%- endif -%}

            {%- if block.settings.name != blank or block.settings.caption != blank -%}
              <span class="nv-video__caption">
                {%- if block.settings.name != blank -%}
                  <strong>{{ block.settings.name | escape }}</strong>
                {%- endif -%}
                {%- if block.settings.caption != blank -%}
                  <span>{{ block.settings.caption | escape }}</span>
                {%- endif -%}
              </span>
            {%- endif -%}

            {%- if block.settings.product != blank -%}
              <a href="{{ block.settings.product.url }}" class="nv-video__shop">
                {{ 'norvik.video.shop' | t }}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%}
          Honest placeholders until real customer videos exist — no stock
          footage pretending to be a customer.
        {%- endcomment -%}
        {%- for i in (1..4) -%}
          <div class="nv-video">
            <span class="nv-video__empty">{{ 'norvik.video.placeholder' | t }}</span>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer videos",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real people, real fit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Seen on our customers" },
    {
      "type": "text",
      "id": "subheading",
      "label": "Supporting line",
      "default": "Tap to watch how it moves, drapes and fits in real life."
    },
    {
      "type": "paragraph",
      "content": "Upload a Shopify-hosted video for the best speed, or paste a YouTube/Vimeo link and add a poster image. Vertical 9:16 clips work best."
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Customer video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video file", "info": "Recommended: upload here rather than using a link." },
        { "type": "video_url", "id": "video_url", "label": "Or a YouTube / Vimeo link", "accept": ["youtube", "vimeo"] },
        { "type": "image_picker", "id": "poster", "label": "Poster image", "info": "Required for YouTube/Vimeo links." },
        { "type": "text", "id": "name", "label": "Customer name", "default": "@customer" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Wearing size M" },
        { "type": "product", "id": "product", "label": "Shop this product" }
      ]
    }
  ],
  "presets": [{ "name": "Customer videos" }]
}
{% endschema %}
