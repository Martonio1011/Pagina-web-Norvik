{%- comment -%}
  Wishlist heart. No app and no account required: the state lives in
  localStorage and is read back by assets/norvik.js.

  Accepts:
    product - required, the product object
    style   - 'floating' (default, over the card image) or 'inline' (PDP)
{%- endcomment -%}
<button
  type="button"
  class="nv-wish{% if style == 'inline' %} nv-wish--inline{% endif %}"
  data-nv-wish="{{ product.handle }}"
  data-nv-label-on="{{ 'norvik.wishlist.saved' | t }}"
  data-nv-label-off="{{ 'norvik.wishlist.save' | t }}"
  aria-pressed="false"
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M12 20.5S3.5 14.9 3.5 9.4A4.9 4.9 0 0 1 12 6.2a4.9 4.9 0 0 1 8.5 3.2c0 5.5-8.5 11.1-8.5 11.1Z" />
  </svg>
  {%- if style == 'inline' -%}
    <span data-nv-wish-label>{{ 'norvik.wishlist.save' | t }}</span>
  {%- else -%}
    <span class="nv-visually-hidden">{{ 'norvik.wishlist.save' | t }}</span>
  {%- endif -%}
</button>
