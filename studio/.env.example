# ---------------------------------------------------------------------------
# Norvik Sourcing Studio — copy this file to `.env` and fill in the values.
# `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local SQLite file. The default works out of the box; leave it as it is
# unless you want the database somewhere else.
DATABASE_URL="file:./norvik-studio.db"

# --- Shopify Admin API -----------------------------------------------------
# Your store domain, without https:// and without a trailing slash.
SHOPIFY_STORE_DOMAIN="norviik.myshopify.com"

# Admin API access token for a custom app.
# Shopify admin > Settings > Apps and sales channels > Develop apps >
# Create an app > Configure Admin API scopes > Install app > reveal token.
# It starts with `shpat_`.
# Required scopes: read_products, write_products, read_inventory,
# read_orders, read_price_rules.
SHOPIFY_ADMIN_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Admin API version. Pinned on purpose: Shopify ships breaking changes
# quarterly, and an app that follows "latest" breaks without warning.
SHOPIFY_API_VERSION="2025-07"

# --- Business rules --------------------------------------------------------
# Estimated shipping cost added to every dropship cost, in USD.
DEFAULT_SHIPPING_COST="5.50"

# Payment gateway fee as a fraction of the retail price (Shopify Payments
# in the US is roughly 2.9% + $0.30; 0.03 is a reasonable blended estimate).
PAYMENT_FEE_RATE="0.03"

# Expected return rate as a fraction of orders. Returns in fashion
# dropshipping run high; 0.08 is a conservative starting point.
RETURN_RATE="0.08"

# --- Trendsi ingestion (Phase 2) -------------------------------------------
# Where the persistent browser profile lives. You log in by hand once with
# `npm run trendsi:login` and the session is reused from here.
TRENDSI_SESSION_DIR=".trendsi-session"

# Seconds between requests to Trendsi. Deliberately slow. Do not lower this
# below 1 without a good reason.
TRENDSI_REQUEST_DELAY_SECONDS="2.5"

# How long a cached Trendsi page stays fresh, in hours.
TRENDSI_CACHE_TTL_HOURS="12"

# --- Logging ---------------------------------------------------------------
# One of: trace, debug, info, warn, error, fatal
LOG_LEVEL="info"
