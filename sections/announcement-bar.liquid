{% style %}
  #shopify-section-{{ section.id }} .announcement-bar {
    width: 100%;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    text-align: center;
    padding: 9px 16px;
  }
  #shopify-section-{{ section.id }} .announcement-bar span {
    font-family: var(--font-body);
    font-size: 11.5px;
    letter-spacing: 0.05em;
    text-transform: lowercase;
  }
  #shopify-section-{{ section.id }} .announcement-bar a {
    color: inherit;
    text-decoration: underline;
  }
{% endstyle %}

{% if section.settings.text != blank %}
  <div class="announcement-bar">
    <span>
      {% if section.settings.link != blank %}
        <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
      {% else %}
        {{ section.settings.text }}
      {% endif %}
    </span>
  </div>
{% endif %}

{% schema %}
{
  "name": "Barra de anuncio",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Texto",
      "default": "envío gratuito desde 90€ · colección verano 2026 ya disponible"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace (opcional)"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#2B2621"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#FAF7F2"
    }
  ]
}
{% endschema %}
