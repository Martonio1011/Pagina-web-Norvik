{% style %}
  #shopify-section-{{ section.id }} .hero {
    width: 100%;
    height: 86vh;
    min-height: 420px;
    position: relative;
  }
  #shopify-section-{{ section.id }} .hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #shopify-section-{{ section.id }} .hero__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    text-align: center;
    padding-bottom: 80px;
    background: linear-gradient(to top, rgba(43,38,33,0.35), rgba(43,38,33,0) 45%);
  }
  #shopify-section-{{ section.id }} .hero__heading {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 38px;
    color: var(--color-bg);
    letter-spacing: 0.02em;
    max-width: 600px;
    line-height: 1.3;
    margin: 0 20px;
  }
  #shopify-section-{{ section.id }} .hero__cta {
    margin-top: 20px;
    font-family: var(--font-body);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    color: var(--color-bg);
    border-bottom: 1px solid var(--color-bg);
    padding-bottom: 5px;
    text-decoration: none;
    text-transform: lowercase;
  }

  @media (max-width: 860px) {
    #shopify-section-{{ section.id }} .hero { height: 520px; }
    #shopify-section-{{ section.id }} .hero__overlay { padding-bottom: 48px; }
    #shopify-section-{{ section.id }} .hero__heading { font-size: 24px; }
  }
{% endstyle %}

<div class="hero">
  {% if section.settings.image %}
    <img
      class="hero__media"
      src="{{ section.settings.image | image_url: width: 2000 }}"
      srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
      sizes="100vw"
      alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
      loading="eager"
      fetchpriority="high"
    >
  {% else %}
    <div class="hero__media placeholder-shot"><span>hero — modelo caminando por la costa, luz de atardecer, movimiento natural</span></div>
  {% endif %}
  <div class="hero__overlay">
    <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {% if section.settings.button_label != blank %}
      <a class="hero__cta" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de fondo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "quiet luxury for endless summers"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "descubrir la colección"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
