{% style %}
  #shopify-section-{{ section.id }} .featured-collection {
    padding: 90px 40px;
  }
  #shopify-section-{{ section.id }} .featured-collection__heading {
    text-align: center;
    margin-bottom: 48px;
    font-family: var(--font-heading);
    font-size: 24px;
    letter-spacing: 0.05em;
    color: var(--color-text);
  }
  #shopify-section-{{ section.id }} .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    max-width: 1200px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .featured-collection__cta {
    text-align: center;
    margin-top: 48px;
  }

  @media (max-width: 860px) {
    #shopify-section-{{ section.id }} .featured-collection { padding: 56px 20px; }
    #shopify-section-{{ section.id }} .featured-collection__heading { margin-bottom: 32px; }
    #shopify-section-{{ section.id }} .featured-collection__grid { grid-template-columns: 1fr 1fr; gap: 24px 14px; }
  }
{% endstyle %}

<div class="featured-collection">
  {% if section.settings.heading != blank %}
    <h2 class="featured-collection__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="featured-collection__grid">
    {% liquid
      assign collection = section.settings.collection
      assign limit = section.settings.products_to_show
    %}
    {% if collection != blank %}
      {% for product in collection.products limit: limit %}
        {% render 'product-card', product: product, show_badge: true %}
      {% endfor %}
    {% else %}
      {% for i in (1..limit) %}
        <div class="product-card">
          <div class="placeholder-shot" style="aspect-ratio:3/4;"><span>producto de ejemplo</span></div>
          <span class="product-card__title">selecciona una colección</span>
        </div>
      {% endfor %}
    {% endif %}
  </div>

  {% if section.settings.button_label != blank and collection != blank %}
    <div class="featured-collection__cta">
      <a class="button-link" href="{{ collection.url }}">{{ section.settings.button_label }}</a>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Colección destacada",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "más vendidos"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Número de productos",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del enlace (opcional)",
      "default": "ver toda la colección"
    }
  ],
  "presets": [
    {
      "name": "Colección destacada"
    }
  ]
}
{% endschema %}
