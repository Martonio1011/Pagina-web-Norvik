{% style %}
  #shopify-section-{{ section.id }} .category-banners {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, 1fr);
    gap: 2px;
    background: var(--color-footer-bg);
  }
  #shopify-section-{{ section.id }} .category-banner {
    position: relative;
    aspect-ratio: 4/5;
    display: block;
    color: var(--color-bg);
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .category-banner img,
  #shopify-section-{{ section.id }} .category-banner .placeholder-shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #shopify-section-{{ section.id }} .category-banner__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 28px;
    background: linear-gradient(to top, rgba(43,38,33,0.4), transparent 50%);
  }
  #shopify-section-{{ section.id }} .category-banner__title {
    font-family: var(--font-heading);
    font-size: 19px;
    color: var(--color-bg);
    letter-spacing: 0.03em;
  }

  @media (max-width: 860px) {
    #shopify-section-{{ section.id }} .category-banners { grid-template-columns: 1fr; }
  }
{% endstyle %}

<div class="category-banners">
  {% for block in section.blocks %}
    <a class="category-banner" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
      {% if block.settings.image %}
        <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
      {% else %}
        <div class="placeholder-shot"><span>{{ block.settings.title | escape }}</span></div>
      {% endif %}
      <div class="category-banner__overlay">
        <span class="category-banner__title">{{ block.settings.title }}</span>
      </div>
    </a>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Banners de categoría",
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "ropa"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Banners de categoría",
      "blocks": [
        { "type": "banner", "settings": { "title": "ropa" } },
        { "type": "banner", "settings": { "title": "baño" } }
      ]
    }
  ]
}
{% endschema %}
