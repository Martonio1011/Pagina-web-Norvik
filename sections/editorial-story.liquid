{% style %}
  #shopify-section-{{ section.id }} .editorial-story {
    display: flex;
    flex-direction: {% if section.settings.image_position == 'right' %}row-reverse{% else %}row{% endif %};
    align-items: center;
  }
  #shopify-section-{{ section.id }} .editorial-story__media {
    flex: 1;
    aspect-ratio: 4/3;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .editorial-story__media img,
  #shopify-section-{{ section.id }} .editorial-story__media .placeholder-shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #shopify-section-{{ section.id }} .editorial-story__text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 60px 70px;
  }
  #shopify-section-{{ section.id }} .editorial-story__title {
    font-family: var(--font-heading);
    font-size: 30px;
    letter-spacing: 0.03em;
    color: var(--color-text);
    line-height: 1.3;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .editorial-story__body {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.8;
    max-width: 440px;
  }

  @media (max-width: 860px) {
    #shopify-section-{{ section.id }} .editorial-story { flex-direction: column; }
    #shopify-section-{{ section.id }} .editorial-story__media { aspect-ratio: 4/3; width: 100%; }
    #shopify-section-{{ section.id }} .editorial-story__text { padding: 36px 24px; }
    #shopify-section-{{ section.id }} .editorial-story__title { font-size: 22px; }
  }
{% endstyle %}

<div class="editorial-story">
  <div class="editorial-story__media">
    {% if section.settings.image %}
      <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" loading="lazy">
    {% else %}
      <div class="placeholder-shot"><span>taller de costura — manos trabajando lino natural</span></div>
    {% endif %}
  </div>
  <div class="editorial-story__text">
    <h2 class="editorial-story__title">{{ section.settings.heading }}</h2>
    <p class="editorial-story__body">{{ section.settings.body }}</p>
    {% if section.settings.link_label != blank %}
      <a class="button-link" href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Historia editorial",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posición de la imagen",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "hecho para durar, no para la temporada"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Texto",
      "default": "cada pieza nace de un taller que conocemos, con tejidos que envejecen bien. diseñamos con la costa mediterránea en mente: prendas que respiran, que se guardan de un verano a otro."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto del enlace",
      "default": "nuestra historia"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace"
    }
  ],
  "presets": [
    {
      "name": "Historia editorial"
    }
  ]
}
{% endschema %}
