{% style %}
  #shopify-section-{{ section.id }} .instagram-feed {
    padding: 0 20px 90px;
  }
  #shopify-section-{{ section.id }} .instagram-feed__heading {
    text-align: center;
    margin-bottom: 48px;
  }
  #shopify-section-{{ section.id }} .instagram-feed__heading a {
    font-family: var(--font-heading);
    font-size: 20px;
    letter-spacing: 0.04em;
    color: var(--color-text);
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .instagram-feed__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 4px;
  }
  #shopify-section-{{ section.id }} .instagram-feed__item {
    aspect-ratio: 1/1;
    display: block;
  }
  #shopify-section-{{ section.id }} .instagram-feed__item img,
  #shopify-section-{{ section.id }} .instagram-feed__item .placeholder-shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 860px) {
    #shopify-section-{{ section.id }} .instagram-feed { padding: 0 20px 56px; }
    #shopify-section-{{ section.id }} .instagram-feed__heading { margin-bottom: 32px; }
    #shopify-section-{{ section.id }} .instagram-feed__grid { grid-template-columns: repeat(3, 1fr); }
  }
{% endstyle %}

<div class="instagram-feed">
  <div class="instagram-feed__heading">
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}" target="_blank" rel="noopener">{{ section.settings.handle }}</a>
    {% else %}
      <span style="font-family:var(--font-heading);font-size:20px;letter-spacing:0.04em;color:var(--color-text);">{{ section.settings.handle }}</span>
    {% endif %}
  </div>
  <div class="instagram-feed__grid">
    {% for block in section.blocks %}
      <a class="instagram-feed__item" href="{{ block.settings.link | default: section.settings.link | default: '#' }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
        {% if block.settings.image %}
          <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ section.settings.handle }}" loading="lazy">
        {% else %}
          <div class="placeholder-shot" style="font-size:9px;"><span>ugc</span></div>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Feed de Instagram",
  "settings": [
    {
      "type": "paragraph",
      "content": "Feed manual. Para sincronizar automáticamente con Instagram, instala una app de la App Store (ej. Foursixty, Social Photos) y sustituye esta sección por su bloque de app."
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Usuario",
      "default": "@norvik.studio"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace al perfil"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Imagen",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (opcional)"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Feed de Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
