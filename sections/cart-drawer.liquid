{% style %}
  #shopify-section-{{ section.id }} .cart-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(43,38,33,0.4);
    z-index: 200;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .cart-drawer-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  #shopify-section-{{ section.id }} .cart-drawer {
    position: fixed;
    top: 0; right: 0; bottom: 0;
    width: 92%;
    max-width: 420px;
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.25s ease;
  }
  #shopify-section-{{ section.id }} .cart-drawer-overlay.is-open .cart-drawer {
    transform: translateX(0);
  }
  #shopify-section-{{ section.id }} .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 28px;
    border-bottom: 1px solid rgba(43,38,33,0.1);
  }
  #shopify-section-{{ section.id }} .cart-drawer__title {
    font-family: var(--font-heading);
    font-size: 18px;
    letter-spacing: 0.04em;
  }
  #shopify-section-{{ section.id }} .cart-drawer__close {
    background: none;
    border: none;
    font-size: 22px;
    line-height: 1;
    color: var(--color-text);
  }
  #shopify-section-{{ section.id }} .cart-drawer__items {
    flex: 1;
    overflow-y: auto;
    padding: 12px 28px;
  }
  #shopify-section-{{ section.id }} .cart-drawer__line {
    display: flex;
    gap: 14px;
    padding: 18px 0;
    border-bottom: 1px solid rgba(43,38,33,0.08);
  }
  #shopify-section-{{ section.id }} .cart-drawer__line img {
    width: 76px;
    height: 96px;
    object-fit: cover;
    flex-shrink: 0;
  }
  #shopify-section-{{ section.id }} .cart-drawer__line-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  #shopify-section-{{ section.id }} .cart-drawer__line-title {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-text);
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .cart-drawer__line-variant {
    font-size: 11.5px;
    color: var(--color-text-muted);
  }
  #shopify-section-{{ section.id }} .cart-drawer__line-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }
  #shopify-section-{{ section.id }} .cart-drawer__line-price {
    font-size: 12.5px;
    color: var(--color-text);
  }
  #shopify-section-{{ section.id }} .cart-drawer__qty {
    width: 44px;
    border: 1px solid var(--color-sand);
    padding: 4px 6px;
    font-size: 12px;
    font-family: var(--font-body);
  }
  #shopify-section-{{ section.id }} .cart-drawer__remove {
    background: none;
    border: none;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    text-decoration: underline;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .cart-drawer__empty {
    padding: 40px 0;
    text-align: center;
    color: var(--color-text-secondary);
    font-size: 13.5px;
  }
  #shopify-section-{{ section.id }} .cart-drawer__footer {
    padding: 20px 28px 28px;
    border-top: 1px solid rgba(43,38,33,0.1);
  }
  #shopify-section-{{ section.id }} .cart-drawer__subtotal {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-body);
    font-size: 13.5px;
    margin-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .cart-drawer__checkout {
    display: block;
    width: 100%;
    text-align: center;
    background: var(--color-text);
    color: var(--color-bg);
    border: none;
    padding: 15px;
    font-family: var(--font-body);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    text-decoration: none;
  }
{% endstyle %}

<div class="cart-drawer-overlay" data-cart-drawer-overlay data-cart-drawer>
  <div class="cart-drawer" role="dialog" aria-modal="true" aria-label="{{ 'general.cart.title' | t: default: 'carrito' }}">
    <div class="cart-drawer__header">
      <span class="cart-drawer__title">{{ 'general.cart.title' | t: default: 'tu carrito' }} ({{ cart.item_count }})</span>
      <button class="cart-drawer__close" data-cart-drawer-close aria-label="{{ 'general.accessibility.close' | t: default: 'cerrar' }}">&times;</button>
    </div>
    <div class="cart-drawer__items">
      {% if cart.item_count == 0 %}
        <p class="cart-drawer__empty">{{ 'general.cart.empty' | t: default: 'tu carrito está vacío' }}</p>
      {% else %}
        {% for item in cart.items %}
          <div class="cart-drawer__line">
            {% if item.image %}
              <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" loading="lazy">
            {% endif %}
            <div class="cart-drawer__line-info">
              <a class="cart-drawer__line-title" href="{{ item.url }}">{{ item.product.title }}</a>
              {% unless item.variant.title == 'Default Title' %}
                <span class="cart-drawer__line-variant">{{ item.variant.title }}</span>
              {% endunless %}
              <div class="cart-drawer__line-row">
                <input class="cart-drawer__qty" type="number" min="0" value="{{ item.quantity }}" data-cart-quantity="{{ item.key }}" aria-label="{{ 'general.cart.quantity' | t: default: 'cantidad' }}">
                <span class="cart-drawer__line-price">{{ item.final_line_price | money }}</span>
              </div>
              <button class="cart-drawer__remove" data-cart-remove="{{ item.key }}">{{ 'general.cart.remove' | t: default: 'eliminar' }}</button>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
    {% if cart.item_count > 0 %}
      <div class="cart-drawer__footer">
        <div class="cart-drawer__subtotal">
          <span>{{ 'general.cart.subtotal' | t: default: 'subtotal' }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <a href="{{ routes.cart_url }}" class="cart-drawer__checkout" style="background:transparent;color:var(--color-text);border:1px solid var(--color-text);margin-bottom:10px;">{{ 'general.cart.view_cart' | t: default: 'ver carrito' }}</a>
        <a href="{{ routes.cart_url }}/checkout" class="cart-drawer__checkout">{{ 'general.cart.checkout' | t: default: 'finalizar compra' }}</a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Carrito (panel)"
}
{% endschema %}
